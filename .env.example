# Database Configuration
DB_USER=eli5user
DB_PASSWORD=eli5password
DB_NAME=eli5_video_teacher
DB_PORT=5432
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}"

# Redis Configuration
REDIS_PASSWORD=eli5redis
REDIS_PORT=6379
REDIS_URL="redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Service API Keys
OPENAI_API_KEY="your-openai-api-key"
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
PIKA_API_KEY="your-pika-api-key"
RUNWAYML_API_KEY="your-runwayml-api-key"

# AWS S3 Configuration
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-west-2"
AWS_S3_BUCKET="eli5-video-storage"

# Server Configuration
NODE_ENV="production"
BACKEND_PORT=3000
FRONTEND_PORT=80

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=10

# Frontend Environment Variables
VITE_API_URL="http://localhost:3000/api"
VITE_WS_URL="http://localhost:3000"
VITE_APP_NAME="ELI5 Video Teacher"

# Docker Configuration
BUILD_TARGET="production"
WORKER_REPLICAS=2

# Nginx Configuration
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Monitoring (optional)
GRAFANA_PASSWORD="admin"

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="noreply@eli5videoteacher.com"

# Logging
LOG_LEVEL="info"